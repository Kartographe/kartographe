# Postgres (consumed by the `database` service)
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password
POSTGRES_DB=app_db
PGDATA=/var/lib/postgresql/data

# Back — App
APP_NAME="Kartographe API"
APP_ENV=local
APP_DEBUG=true
APP_VERSION=0.1.0
API_BASE_URL=http://localhost:8000
# Public URL of the front SPA — used to build the links in transactional emails.
APP_URL=http://localhost:5173

# Back — Logging. LOG_LEVEL is the baseline; each LOG_LEVEL_<TYPOLOGY> overrides
# one family of loggers. Leave a typology empty to inherit LOG_LEVEL.
# Accepted values: DEBUG, INFO, WARNING, ERROR, CRITICAL (case-insensitive).
LOG_LEVEL=INFO
# Kartographe's own loggers (`kartographe.*`, e.g. `kartographe.email`).
LOG_LEVEL_APP=
# SQLAlchemy + Alembic. Kept at WARNING by default: INFO echoes every SQL
# statement, DEBUG echoes every row.
LOG_LEVEL_SQL=WARNING
# Uvicorn startup/errors and FastAPI internals.
LOG_LEVEL_SERVER=
# The per-request access log — set to WARNING to silence it.
LOG_LEVEL_ACCESS=
# The MCP transport and the `fastapi-mcp` bridge.
LOG_LEVEL_MCP=

# Back — Database
# Reached over the docker-compose network via the `db` link alias on Postgres'
# internal port 5432 (the host-published port 5431 only applies when connecting
# from the host, e.g. `...@localhost:5431/...`).
DATABASE_URL=postgresql+psycopg2://app_user:app_password@db:5432/app_db
RUN_MIGRATIONS=true

# Back — JWT. MUST be at least 32 bytes (256 bits) for HS256. Generate with
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
JWT_SECRET=dev-insecure-placeholder-change-me-32b
JWT_ALGORITHM=HS256
JWT_ISSUER=kartographe
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=86400
# Longer refresh TTL granted when the user ticks "remember me" at login.
JWT_REFRESH_LONG_TTL_SECONDS=604800

# Back — Two-factor / WebAuthn.
# OTP_ISSUER labels the account in the user's authenticator app.
OTP_ISSUER=Kartographe
# WebAuthn security keys. WEBAUTHN_RP_ID is the registrable domain (no scheme /
# port); WEBAUTHN_ORIGINS is the exact browser origin(s), JSON array.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Kartographe
WEBAUTHN_ORIGINS=["http://localhost:5173"]

# Back — Google SSO. Sign-in with Google is available only when this is set.
GOOGLE_CLIENT_ID=

# Back — Cloudflare Turnstile. Anti-bot on `/auth/*`, enforced only when a
# secret is present (leave empty to disable in local dev).
TURNSTILE_SECRET=

# Back — Transactional email. SERVICE_EMAIL_TYPE selects the backend (`smtp`);
# leave empty to send nothing (the activation/reset link is logged instead).
SERVICE_EMAIL_TYPE=
EMAIL_EMITTER_ADDRESS=no-reply@kartographe.local
EMAIL_EMITTER_NAME=Kartographe
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Back — File storage. STORAGE_BACKEND selects `local` (files under
# STORAGE_LOCAL_ROOT, served from the STORAGE_PUBLIC_URL_BASE static mount) or
# `s3` (S3-compatible object storage; bucket required). STORAGE_S3_ENDPOINT_URL
# targets AWS S3 / Scaleway / MinIO; STORAGE_S3_PUBLIC_URL_BASE is an optional CDN base.
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=storage
STORAGE_PUBLIC_URL_BASE=/uploads
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_PUBLIC_URL_BASE=

# Back — MCP. Serves the `/mcp` Streamable HTTP transport and exposes the
# `/v1/*` routes as MCP tools.
MCP_ENABLED=true
MCP_MOUNT_PATH=/mcp

# Back — OpenAPI / Scalar. Gates the HTML reference at `GET /docs`.
# `openapi.json` stays reachable regardless.
DOCS_ENABLED=true


# Front
VITE_APP_NAME=Kartographe
VITE_APP_ENVIRONMENT=local
VITE_APP_URL=http://localhost:5173/
VITE_API_URL=http://localhost:8000
VITE_MCP_URL=http://localhost:8000/mcp
# Cloudflare Turnstile site key for the `/auth/*` widgets. Empty by default:
# no widget, forms aren't gated (the backend also disables Turnstile without a
# secret). To test the widget, use Cloudflare's "always passes" key
# 1x00000000000000000000AA.
VITE_TURNSTILE_SITE_KEY=
# Google OAuth client id for the "Sign in with Google" button (optional).
VITE_GOOGLE_CLIENT_ID=
