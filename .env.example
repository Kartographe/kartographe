# Postgres (consumed by the `database` service)
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password
POSTGRES_DB=app_db
PGDATA=/var/lib/postgresql/data

# Back — App
APP_NAME="Kartographe API"
APP_ENV=local
APP_DEBUG=true
APP_VERSION=0.1.0
API_BASE_URL=http://localhost:8000

# Back — Database
# Reached over the docker-compose network via the `db` link alias on Postgres'
# internal port 5432 (the host-published port 5431 only applies when connecting
# from the host, e.g. `...@localhost:5431/...`).
DATABASE_URL=postgresql+psycopg2://app_user:app_password@db:5432/app_db
RUN_MIGRATIONS=true

# Back — JWT. MUST be at least 32 bytes (256 bits) for HS256. Generate with
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
JWT_SECRET=dev-insecure-placeholder-change-me-32b
JWT_ALGORITHM=HS256
JWT_ISSUER=kartographe
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=604800

# Back — MCP. Serves the `/mcp` Streamable HTTP transport and exposes the
# `/v1/*` routes as MCP tools.
MCP_ENABLED=true
MCP_MOUNT_PATH=/mcp

# Back — OpenAPI / Scalar. Gates the HTML reference at `GET /docs`.
# `openapi.json` stays reachable regardless.
DOCS_ENABLED=true


# Front
VITE_APP_NAME=Kartographe
VITE_APP_ENVIRONMENT=local
VITE_APP_URL=http://localhost:5173/
VITE_API_URL=http://localhost:8000
VITE_MCP_URL=http://localhost:8000/mcp
