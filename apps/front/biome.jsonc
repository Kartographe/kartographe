{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "overrides": [
    {
      // `public/` holds static assets (favicon, logos) — not source to lint.
      "includes": ["public/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          }
        }
      }
    },
    {
      // TanStack Router param files use camelCase ($id)
      "includes": ["src/routes/**/$*"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "requireAscii": true,
                "filenameCases": ["kebab-case", "camelCase"]
              }
            }
          }
        }
      }
    }
  ]
}
